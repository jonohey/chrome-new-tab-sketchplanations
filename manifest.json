{
  "manifest_version": 3,
  "name": "Sketchplanations New Tab",
  "version": "1.0.0",
  "version_name": "1.0.0",
  "description": "Shows a Sketchplanation on opening a new tab.",
  "homepage_url": "https://sketchplanations.com",
  "author": "Jonathan Hey",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "images/favicon-16x16.png",
    "32": "images/favicon-32x32.png",
    "48": "images/favicon-48x48.png",
    "128": "images/favicon-128x128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://sketchplanations.com/*",
    "https://www.google.com/generate_204"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://sketchplanations.com https://www.google.com"
  }
}
